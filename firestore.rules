rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function authenticated() {
      return request.auth != null;
    }

    function signedIn() {
      return authenticated() && request.auth.token.email_verified == true;
    }

    function isAdmin() {
      return signedIn()
        && exists(/databases/$(database)/documents/admins/$(request.auth.uid))
        && get(/databases/$(database)/documents/admins/$(request.auth.uid)).data.active == true
        && get(/databases/$(database)/documents/admins/$(request.auth.uid)).data.email == request.auth.token.email;
    }

    function validNewProfile(uid) {
      return authenticated()
        && uid == request.auth.uid
        && request.resource.data.keys().hasOnly(['email', 'approved', 'createdAt', 'tools'])
        && request.resource.data.email == request.auth.token.email
        && request.resource.data.approved == false
        && request.resource.data.tools == {};
    }

    function validSelfServiceUpdate(uid) {
      return signedIn()
        && uid == request.auth.uid
        && request.resource.data.email == resource.data.email
        && request.resource.data.approved == resource.data.approved
        && request.resource.data.createdAt == resource.data.createdAt
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['tools'])
        && request.resource.data.tools.diff(resource.data.tools).affectedKeys()
          .hasOnly(['gettingstarted', 'spartan', 'seg', 'qsm', 'dwi', 'rsfMRI', 'tfMRI', 'MRS', 'ASL'])
        && validToolRequest('gettingstarted') && validToolRequest('spartan') && validToolRequest('seg')
        && validToolRequest('qsm') && validToolRequest('dwi')
        && validToolRequest('rsfMRI') && validToolRequest('tfMRI')
        && validToolRequest('MRS') && validToolRequest('ASL');
    }

    function validToolRequest(toolId) {
      return !request.resource.data.tools.diff(resource.data.tools).affectedKeys().hasAny([toolId])
        || (request.resource.data.tools[toolId].diff(resource.data.tools.get(toolId, {})).affectedKeys()
              .hasOnly(['requested', 'timestamp'])
            && request.resource.data.tools[toolId].requested == true);
    }

    match /admins/{uid} {
      allow read: if signedIn() && request.auth.uid == uid;
      allow write: if false;
    }

    match /users/{uid} {
      allow read: if isAdmin() || (signedIn() && request.auth.uid == uid);
      allow create: if validNewProfile(uid);
      allow update: if isAdmin() || validSelfServiceUpdate(uid);
      allow delete: if isAdmin();
    }

    match /{document=**} {
      allow read, write: if false;
    }
  }
}
